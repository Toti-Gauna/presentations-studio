{
  "name": "presentations-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Motor de presentaciones dirigidas en vivo (núcleo reutilizable) con control móvil por QR. Primer caso: pitch Handyx.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "servidor": "node server/main.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validar": "node scripts/validar-decks.ts",
    "qr": "node scripts/generar-qr.ts",
    "exportar:pdf": "node scripts/exportar-pdf.ts",
    "exportar:video": "node scripts/exportar-video.ts",
    "exportar:pptx": "node scripts/exportar-pptx.ts",
    "paquete:local": "node scripts/paquete-local.ts",
    "local": "node scripts/servir-local.ts",
    "e2e": "node e2e/recorrido.ts",
    "verify": "npm run typecheck && npm test && npm run validar && python3 -I scripts/generar-guion-aticma.py --comprobar && vite build",
    "escenarios": "node scripts/escenarios.ts",
    "publicar": "node scripts/publicar.ts",
    "configurar": "node scripts/configurar-deploy.ts",
    "docker:build": "docker build -t presentaciones:actual .",
    "grabar:vivo": "node scripts/grabar-en-vivo.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "gsap": "3.15.0",
    "uqr": "0.1.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "jsqr": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
