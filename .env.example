# Cliente (build, público: NO poner secretos)
VITE_SERVIDOR=https://sesiones.handyc.com   # servidor de sesiones permitido para el control remoto
VITE_DECK=handyx                            # deck por defecto
VITE_BASE=./                                # base relativa: sirve en raíz, subcarpeta o paquete local
# VITE_PUBLICADA=aticma-2026-11-04          # usar una versión congelada

# Servidor de sesiones (entorno privado de Render/VPS)
PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGINS=https://pitch.handyc.com    # orígenes exactos, separados por coma
CONFIAR_PROXY=true                          # detrás de Render o Caddy
QR_REDIRECCIONES=decks/handyx/qr.json       # destinos de /r/<id>
# SERVIR_ESTATICOS=dist                     # opcional (VPS o ensayo en red local): sirve también el build
